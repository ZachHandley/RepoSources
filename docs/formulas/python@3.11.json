nyou'll need to read your database using the older version of Homebrew Python and convert to another format.\n`dbm` still defaults to `dbm.gnu` when it is installed.\n\nIf you do not need a specific version of Python, and always want Homebrew's `python3` in your PATH:\n  brew install python3\n\nFor more information about Homebrew and Python, see: https://docs.brew.sh/Homebrew-and-Python\n","installed":[],"linked_keg":null,"pinned":false,"outdated":false,"deprecated":false,"deprecation_date":"2027-11-01","deprecation_reason":null,"deprecation_replacement_formula":null,"deprecation_replacement_cask":null,"deprecate_args":{"date":"2027-11-01","because":"deprecated_upstream","replacement_formula":null,"replacement_cask":null},"disabled":false,"disable_date":"2028-11-01","disable_reason":null,"disable_replacement_formula":null,"disable_replacement_cask":null,"disable_args":{"date":"2028-11-01","because":"deprecated_upstream","replacement_formula":null,"replacement_cask":null},"post_install_steps":[{"type":"bootstrap_cpython"}],"post_install_defined":false,"service":null,"tap_git_head":"9fb4d53b015ed4693981db3fe54efd00b3710491","ruby_source_path":"Formula/p/python@3.11.rb","ruby_source_checksum":{"sha256":"c1ca553942fea43942ed1ad0c16af0d6a1a130016ba4a9e14a8b562ab6ca8d57"},"variations":{"x86_64_linux":{"dependencies":["mpdecimal","openssl@3","sqlite","xz","berkeley-db@5","libnsl","libtirpc","zlib-ng-compat"]},"arm64_linux":{"dependencies":["mpdecimal","openssl@3","sqlite","xz","berkeley-db@5","libnsl","libtirpc","zlib-ng-compat"]}},"executables":["2to3-3.11","idle3.11","pydoc3.11","python3.11","python3.11-config"],"vulnerabilities":{"open":[{"id":"BREW-python@3.11-GHSA-xmj3-9gf7-h52w","upstream":["GHSA-xmj3-9gf7-h52w"],"summary":"setuptools: Windows path escape via namespace_packages.txt during legacy wheel installation  Description"}],"patched":[],"fixed_count":13}}
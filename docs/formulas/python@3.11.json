l into the site-package directory\n  $HOMEBREW_PREFIX/lib/python3.11/site-packages\n\n`idle3.11` requires tkinter, which is available separately:\n  brew install python-tk@3.11\n\ngdbm (`dbm.gnu`) is no longer included in this formula, but it is available separately:\n  brew install python-gdbm@3.11\n`dbm.ndbm` changed database backends in Homebrew Python 3.11.\nIf you need to read a database from a previous Homebrew Python created via `dbm.ndbm`,\nyou'll need to read your database using the older version of Homebrew Python and convert to another format.\n`dbm` still defaults to `dbm.gnu` when it is installed.\n\nIf you do not need a specific version of Python, and always want Homebrew's `python3` in your PATH:\n  brew install python3\n\nFor more information about Homebrew and Python, see: https://docs.brew.sh/Homebrew-and-Python\n","installed":[],"linked_keg":null,"pinned":false,"outdated":false,"deprecated":false,"deprecation_date":"2027-11-01","deprecation_reason":null,"deprecation_replacement_formula":null,"deprecation_replacement_cask":null,"deprecate_args":{"date":"2027-11-01","because":"deprecated_upstream","replacement_formula":null,"replacement_cask":null},"disabled":false,"disable_date":"2028-11-01","disable_reason":null,"disable_replacement_formula":null,"disable_replacement_cask":null,"disable_args":{"date":"2028-11-01","because":"deprecated_upstream","replacement_formula":null,"replacement_cask":null},"post_install_steps":[{"type":"bootstrap_cpython"}],"post_install_defined":false,"service":null,"tap_git_head":"21af5e69e619485e051a21147af172012aa6e394","ruby_source_path":"Formula/p/python@3.11.rb","ruby_source_checksum":{"sha256":"48853d42656056a38a5b139f3544c701937e3494d31ad02535cf40fcde340b15"},"variations":{"x86_64_linux":{"dependencies":["mpdecimal","openssl@3","sqlite","xz","berkeley-db@5","libnsl","libtirpc","zlib-ng-compat"]},"arm64_linux":{"dependencies":["mpdecimal","openssl@3","sqlite","xz","berkeley-db@5","libnsl","libtirpc","zlib-ng-compat"]
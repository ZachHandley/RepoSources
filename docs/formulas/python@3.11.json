 python3\n\nFor more information about Homebrew and Python, see: https://docs.brew.sh/Homebrew-and-Python\n","installed":[],"linked_keg":null,"pinned":false,"outdated":false,"deprecated":false,"deprecation_date":"2027-11-01","deprecation_reason":null,"deprecation_replacement_formula":null,"deprecation_replacement_cask":null,"deprecate_args":{"date":"2027-11-01","because":"deprecated_upstream","replacement_formula":null,"replacement_cask":null},"disabled":false,"disable_date":"2028-11-01","disable_reason":null,"disable_replacement_formula":null,"disable_replacement_cask":null,"disable_args":{"date":"2028-11-01","because":"deprecated_upstream","replacement_formula":null,"replacement_cask":null},"post_install_steps":[{"type":"bootstrap_cpython"}],"post_install_defined":false,"service":null,"tap_git_head":"91f7c13c6e16eac298ac4f5ed5e83cbd46c0bac4","ruby_source_path":"Formula/p/python@3.11.rb","ruby_source_checksum":{"sha256":"9243ecedbb7ff093dc152c496188a8f8d591b2b306fed88513a4f07562605dd1"},"variations":{"x86_64_linux":{"dependencies":["mpdecimal","openssl@3","sqlite","xz","berkeley-db@5","libnsl","libtirpc","zlib-ng-compat"]},"arm64_linux":{"dependencies":["mpdecimal","openssl@3","sqlite","xz","berkeley-db@5","libnsl","libtirpc","zlib-ng-compat"]}},"executables":["2to3-3.11","idle3.11","pydoc3.11","python3.11","python3.11-config"],"vulnerabilities":{"open":[],"patched":[],"fixed_count":13}}